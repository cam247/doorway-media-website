# Copy this file to `.env.local` and fill in the key. `.env.local` is ignored by
# git — the API key must never be committed.
#
# Only RESEND_API_KEY is required. The two addresses have working defaults, so
# the contact form sends as soon as a key is present.

# ── Contact form delivery (Resend) ───────────────────────────────────────────

# From https://resend.com/api-keys — starts with "re_".
RESEND_API_KEY=

# Where enquiries land. Defaults to Cam@doorway.media.
# CONTACT_TO_EMAIL=Cam@doorway.media

# Who the mail appears to come from. Defaults to Resend's shared testing sender,
# "Doorway Media <onboarding@resend.dev>", which needs no setup but will ONLY
# deliver to the address that owns the Resend account.
#
# To receive mail at any other address, verify doorway.media at
# https://resend.com/domains and set this to an address on that domain:
# CONTACT_FROM_EMAIL=Doorway Media <hello@doorway.media>
